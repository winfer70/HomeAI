# HomeAI — copy this file to .env and fill in your values

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_S=90
REACT_MAX_ITERATIONS=6

# Home Assistant
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your_long_lived_access_token_here
HA_TIMEOUT_S=10

# Web Search — SearXNG (primary, self-hosted)
SEARXNG_URL=http://localhost:8888
# Brave Search API key (optional fallback if SearXNG is down)
BRAVE_API_KEY=
SEARCH_RESULTS=5
SEARCH_TIMEOUT_S=15

# Memory (SQLite)
MEMORY_DB_PATH=./homeai_memory.db
MEMORY_WINDOW=10

# Logging
LOG_LEVEL=INFO
LOG_FILE=./homeai.log

# Uptime Kuma utility scripts (optional)
KUMA_HOST=http://localhost:3001
KUMA_USERNAME=
KUMA_PASSWORD=
