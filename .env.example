# HomeAI — copy this file to .env and fill in your values

# Timezone
TZ=Europe/Warsaw

# Deployment host (REDACTED-HOST)
HOMEAI_DOMAIN=REDACTED-HOST.local

# Local LLM (Ollama — REDACTED-HOST: 10.0.0.101:11434)
OLLAMA_BASE_URL=http://10.0.0.101:11434
OLLAMA_MODEL=qwen3:8b
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_S=90
REACT_MAX_ITERATIONS=6

# Home Assistant (REDACTED-HOST: 10.0.0.104:8123)
HA_URL=http://10.0.0.104:8123
HA_TOKEN=your_long_lived_access_token_here
HA_TIMEOUT_S=10

# Matter Server (runs on REDACTED-HOST alongside HA, ws://localhost:5580/ws)
# No env needed here — HA connects to matter-server, not the other way around.
# Configure in HA: Settings → Integrations → Matter → ws://localhost:5580/ws

# Web Search — SearXNG (self-hosted)
SEARXNG_URL=http://localhost:8888
BRAVE_API_KEY=
SEARCH_RESULTS=5
SEARCH_TIMEOUT_S=15

# Memory (SQLite)
MEMORY_DB_PATH=./homeai_memory.db
MEMORY_WINDOW=10

# Logging
LOG_LEVEL=INFO
LOG_FILE=./homeai.log
