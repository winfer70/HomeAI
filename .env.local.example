# Heimdall local secrets — copy this file to .env.local (gitignored) and fill in real values.
#
# Every heimdall/scripts/*.py and heimdall/tests/test_matrix.py reads these via
# os.environ.get(...) already - this file is just a single, consistent place to
# keep the actual values on this machine instead of one-off $env:TEMP files per
# session (see backlog #9 in heimdall/PHASE1_5_HARDENING_AND_PHASE2_PLAN.md).
#
# Load into your current PowerShell session with:
#   . .\heimdall\scripts\Load-EnvLocal.ps1

# Home Assistant long-lived access token (vesemir) - required by almost every script
HEIMDALL_HA_TOKEN=
HEIMDALL_HA_URL=http://192.168.0.108:8123
HEIMDALL_HA_WS_URL=ws://192.168.0.108:8123/api/websocket

# n8n API key (Settings > API) - only needed by deploy_n8n_workflow.py
N8N_API_KEY=
N8N_URL=https://n8n.kamilon8n.win

# ntfy heimdall_bot token - only needed by test_matrix.py / ntfy_failure_logger.py
HEIMDALL_NTFY_TOKEN=
HEIMDALL_NTFY_URL=http://192.168.0.108:8081

# Heimdall persistent-memory service token (jaskier) - only needed by memory_poller.py
HEIMDALL_MEMORY_TOKEN=
